; Godot project for the native Pokemon Red reimplementation.
; The whole game is drawn as a 160x144 Game Boy tile screen (see scripts/gb/screen.gd)
; scaled by an integer factor. Every tile and string comes from assets exported by
; tools/export_data.py out of the pokered disassembly.

config_version=5

[application]

config/name="포켓몬 레드 Godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GB="*res://scripts/gb/gb.gd"
GameData="*res://scripts/gb/data.gd"
Text="*res://scripts/gb/text.gd"
Menu="*res://scripts/gb/menu.gd"
Sound="*res://scripts/gb/sound.gd"
SGB="*res://scripts/gb/sgb.gd"
Settings="*res://scripts/engine/settings.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=748
window/stretch/mode="disabled"

[input]

